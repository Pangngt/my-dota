<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 p-6 md:p-12">
    <div class="max-w-4xl mx-auto bg-white p-8 md:p-12 rounded-2xl shadow-lg">
        <a href="/" class="text-blue-500 font-semibold hover:underline mb-8 inline-block">&larr; Back to Catalog</a>
        
        <!-- Product Details -->
        <div class="flex flex-col md:flex-row gap-10">
            <img src="<%= product.thumbnail %>" alt="<%= product.title %>" class="w-full md:w-1/2 object-cover rounded-xl shadow-sm">
            <div class="flex-1">
                <span class="bg-gray-200 text-gray-700 text-xs px-3 py-1 rounded-full uppercase font-bold tracking-wider"><%= product.category %></span>
                <h1 class="text-4xl font-extrabold text-gray-900 mt-4"><%= product.title %></h1>
                <p class="text-3xl text-blue-600 font-black mt-3">$<%= product.price %></p>
                <p class="text-gray-600 mt-6 leading-relaxed text-lg"><%= product.description %></p>
            </div>
        </div>
        
        <hr class="border-gray-200 my-10">
        
        <!-- Update Form (CRUD: Update) -->
        <h2 class="text-2xl font-bold text-gray-800 mb-6">Update Product</h2>
        <form action="/product/<%= product.id %>/update" method="POST" class="flex flex-col gap-5 max-w-lg">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
                <input type="text" name="title" value="<%= product.title %>" class="w-full p-3 border border-gray-300 rounded-lg" required>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                <textarea name="description" rows="4" class="w-full p-3 border border-gray-300 rounded-lg" required><%= product.description %></textarea>
            </div>
            <button type="submit" class="bg-green-600 text-white px-6 py-3 rounded-lg font-bold hover:bg-green-700 transition self-start shadow-md">Submit Update</button>
        </form>
    </div>
</body>
</html>